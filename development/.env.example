# Copy to .env and fill in. Never commit .env.

# Docker Compose project namespace — keeps containers, volumes, and networks
# from clashing with sibling stacks. Used both for ${COMPOSE_PROJECT}
# interpolation in container_name AND as the docker compose project name
# (via the top-level `name:` directive in docker-compose.yml — wins over
# the directory-based default of `development`).
COMPOSE_PROJECT=nautobot-phones-dev

# Public domain for the dev instance, served via caddy-docker-proxy.
# Caddy must be running on the external `caddy` network with a matching label rule.
DOMAIN=phones-dev.example.com

# Nautobot core
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=changeme-postgres-password
NAUTOBOT_REDIS_PASSWORD=changeme-redis-password
NAUTOBOT_SECRET_KEY=changeme-50-chars-of-random-bytes-here-please-rotate
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=changeme-admin-password
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# Phone-system lab credentials — used by integration tests / nightly sync runs.
# Leave blank in v1 development; populate when you have a CCM/FreePBX target.
# Production deployments use Nautobot SecretsGroup, not env vars.
CCM_LAB_HOST=
CCM_LAB_USER=
CCM_LAB_PASSWORD=
FREEPBX_LAB_HOST=
FREEPBX_LAB_TOKEN=
