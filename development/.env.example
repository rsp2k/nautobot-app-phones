# Copy to .env and fill in. Never commit .env.

# Docker Compose project namespace — keeps containers, volumes, and networks
# from clashing with sibling stacks. Used both for ${COMPOSE_PROJECT}
# interpolation in container_name AND as the docker compose project name
# (via the top-level `name:` directive in docker-compose.yml — wins over
# the directory-based default of `development`).
COMPOSE_PROJECT=nautobot-phones-dev

# Public domain for the dev instance, served via caddy-docker-proxy.
# Caddy must be running on the external `caddy` network with a matching label rule.
DOMAIN=phones-dev.example.com

# Nautobot core
NAUTOBOT_DB_NAME=nautobot
NAUTOBOT_DB_USER=nautobot
NAUTOBOT_DB_PASSWORD=changeme-postgres-password
NAUTOBOT_REDIS_PASSWORD=changeme-redis-password
NAUTOBOT_SECRET_KEY=changeme-50-chars-of-random-bytes-here-please-rotate
NAUTOBOT_SUPERUSER_NAME=admin
NAUTOBOT_SUPERUSER_EMAIL=admin@example.com
NAUTOBOT_SUPERUSER_PASSWORD=changeme-admin-password
NAUTOBOT_SUPERUSER_API_TOKEN=0123456789abcdef0123456789abcdef01234567

# Cisco UCM AXL credentials — read by the SSoT Job via Nautobot's
# environment-variable secrets provider (no plaintext in the Nautobot DB).
# AXL_URL can be a hostname (`ccm.example.org`) or a full URL — the Job
# extracts the host and uses the standard 8443/axl endpoint.
AXL_URL=
AXL_USER=
AXL_PASS=

# AXL_HOST (bare hostname) and BASTION_HOST (routable IP) wire up
# docker-compose's extra_hosts directive — pins the AXL FQDN to a known IP
# without relying on docker's internal DNS forwarder. Set both when the
# AXL FQDN doesn't resolve from inside the container, or when you're
# routing through a bastion/jump-host that owns the public-facing IP.
AXL_HOST=
BASTION_HOST=

# AXL WSDL location inside the container. Default: /opt/axl/<version>/AXLAPI.wsdl.
# Set AXL_WSDL_PATH to override (e.g. when mounting a single-file WSDL).
# WSDL ships with CUCM under Application > Plugins > AXLSQLToolkit.
AXL_VERSION=15.0
AXL_WSDL_PATH=

# FreePBX (external lab cluster, optional).
FREEPBX_LAB_HOST=
FREEPBX_LAB_TOKEN=

# Local FreePBX 17 dev container (escomputers/freepbx:17). Caddy serves it
# at $FREEPBX_DOMAIN. Passwords are written to development/freepbx/secrets/
# *.txt files (Docker file-based secrets) by the `make freepbx-init` target.
FREEPBX_DOMAIN=freepbx-dev.example.com
FREEPBX_MYSQL_ROOT_PASSWORD=changeme-fpbx-mysql-root
FREEPBX_DB_PASSWORD=changeme-fpbx-user-pass
# (SASL/Postfix placeholder is hardcoded in the Makefile — our adapter
# never sends mail, but the upstream FreePBX image probes the file at boot.)
